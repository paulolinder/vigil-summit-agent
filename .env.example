# =============================================================
# Vigil Summit Agent — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# No Dokploy: cole estas variáveis no campo Environment do projeto.
# =============================================================

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...                        # service_role key (nunca a anon)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...       # anon/public key

# ── Resend ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Vigil Summit <noreply@vigil.ai>
RESEND_WEBHOOK_SECRET=whsec_...            # Resend → Webhooks → Signing Secret

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://url-do-backend.seudominio.com
NEXT_PUBLIC_API_KEY=mude-essa-chave-em-producao
DASHBOARD_PASSWORD=mude-essa-senha-em-producao

# ── Segurança (backend) ──────────────────────────────────────
API_KEY=mude-essa-chave-em-producao        # mesmo valor de NEXT_PUBLIC_API_KEY
CORS_ORIGINS=https://seudominio.com        # URL do frontend; múltiplos separados por vírgula

# ── Integrações opcionais ────────────────────────────────────
# O sistema funciona sem estas — cada integração degrada graciosamente
APOLLO_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=vigil
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
