# =============================================================
# Vigil Summit Agent — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# No Dokploy: cole estas variáveis no campo Environment do projeto.
#
# ATENÇÃO: não use # em valores de variáveis — é interpretado como
# início de comentário. Ex: SENHA=abc#123 vira SENHA=abc
# =============================================================

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────
# service_role key (nunca a anon — usada apenas no backend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# anon/public key (usada no frontend via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Resend ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Vigil Summit <noreply@vigil.ai>
# Resend → Webhooks → Signing Secret
RESEND_WEBHOOK_SECRET=whsec_...

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://url-do-backend.seudominio.com
# mesmo valor de API_KEY abaixo
NEXT_PUBLIC_API_KEY=mude-essa-chave-em-producao
DASHBOARD_PASSWORD=mude-essa-senha-em-producao

# ── Segurança (backend) ──────────────────────────────────────
# mesmo valor de NEXT_PUBLIC_API_KEY acima
API_KEY=mude-essa-chave-em-producao
# URL do frontend — múltiplos domínios separados por vírgula
CORS_ORIGINS=https://seudominio.com

# ── Integrações opcionais ────────────────────────────────────
# O sistema funciona sem estas — cada integração degrada graciosamente
APOLLO_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=vigil
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
