# Setup: cp .env.example .env  e preencha os valores reais antes de rodar o servidor.
# Em produção (Dokploy), configure as variáveis diretamente no painel — o .env não é usado.

# LLM provider — set ONE. If both are set, Anthropic wins.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# OpenAI model overrides (defaults shown). Verify exact IDs against the OpenAI API.
OPENAI_AGENT_MODEL=gpt-4.1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Vigil Summit <noreply@vigil.ai>
RESEND_WEBHOOK_SECRET=whsec_...

# ── MODO DEMO ───────────────────────────────────────────────────────────────
# Deixe APOLLO_API_KEY, EVOLUTION_API_KEY e CAL_API_KEY VAZIAS para ativar os
# mocks automaticamente (enriquecimento determinístico, WhatsApp simulado,
# booking simulado). Email (Resend) e LLM (Claude/OpenAI) seguem reais.
# Com a chave preenchida, o serviço correspondente usa a API real.

# Apollo.io (vazio → enriquecimento mockado determinístico)
APOLLO_API_KEY=

# Evolution API (WhatsApp — vazio → mensagem SIMULATED visível no dashboard)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=vigil

# Cal.com (vazio → link fake + booking simulado fecha o funil)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# DEMO_FAST_FORWARD: comprime a régua (dias→minutos) para testar o funil em minutos.
DEMO_FAST_FORWARD=false

# Segurança
API_KEY=vigil-secret-key-2026
# Secret do token de confirmação de presença (opcional; fallback para API_KEY).
# ATENÇÃO: trocar este valor invalida os links de confirmação já enviados.
CONFIRM_TOKEN_SECRET=

# CORS — domínio do frontend em produção (separar múltiplos por vírgula)
CORS_ORIGINS=https://seudominio.com
