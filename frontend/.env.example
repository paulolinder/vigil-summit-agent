# Backend API — server-side only (no NEXT_PUBLIC_ prefix)
BACKEND_API_URL=https://your-project.up.railway.app
BACKEND_API_KEY=vigil-secret-key-change-in-production

# Public backend URL (only for createLead, which is a public form submission)
NEXT_PUBLIC_API_URL=https://your-project.up.railway.app

# Supabase (use the anon/public key, NOT the service_role key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Dashboard password protection
DASHBOARD_PASSWORD=change-me-in-production
SESSION_SECRET=change-me-32-chars-minimum-random

# LLM provider for the chatbot (server-side only) — set ONE. If both set, Anthropic wins.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
